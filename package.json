    "demo:real-world-spatial-foundation": "tsx scripts/demo-real-world-spatial-foundation.ts",
    "demo:order-fulfillment-foundation": "tsx scripts/demo-order-fulfillment-foundation.ts",
    "demo:site-agent-association": "tsx scripts/demo-site-agent-association.ts",
    "demo:residential-access": "tsx scripts/demo-residential-access.ts",
    "demo:residential-interaction": "tsx scripts/demo-residential-interaction.ts",
    "demo:npc-presence-observation": "tsx scripts/demo-npc-presence-observation.ts",
