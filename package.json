{
  "name": "my-virtual-community",
  "version": "0.1.0",
  "description": "A persistent virtual world based on the Ciudad Juárez–El Paso region",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-client-assets.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:active-hours": "tsx src/index.ts --preset-active-hours",
    "build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "launch:windows": "powershell -ExecutionPolicy Bypass -File scripts/launch-windows.ps1",
    "shortcut:desktop": "powershell -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "test": "node scripts/run-tests.js",
    "demo:persistence": "tsx scripts/demo-persistence.ts",
    "demo:simulation": "tsx scripts/demo-simulation.ts",
    "demo:spatial": "tsx scripts/demo-spatial.ts",
    "demo:restaurant": "tsx scripts/demo-restaurant.ts",
    "demo:restaurant-entry": "tsx scripts/demo-restaurant-entry.ts",
    "demo:commercial-offering": "tsx scripts/demo-commercial-offering.ts",
    "demo:purchase": "tsx scripts/demo-purchase.ts",
    "demo:activity": "tsx scripts/demo-activity.ts",
    "demo:spatial-movement": "tsx scripts/demo-spatial-movement.ts",
    "demo:agent-interaction": "tsx scripts/demo-agent-interaction.ts",
    "demo:world-perception": "tsx scripts/demo-world-perception.ts",
    "demo:purchase-history": "tsx scripts/demo-purchase-history.ts",
    "demo:coffee-completion-history": "tsx scripts/demo-coffee-completion-history.ts",
    "demo:npc-routine": "tsx scripts/demo-npc-routine.ts",
    "demo:building-traversal": "tsx scripts/demo-building-traversal.ts",
    "demo:player-history": "tsx scripts/demo-player-history.ts",
    "demo:reciprocal-greeting": "tsx scripts/demo-reciprocal-greeting.ts",
    "demo:npc-offering-action": "tsx scripts/demo-npc-offering-action.ts",
    "demo:street-traversal": "tsx scripts/demo-street-traversal.ts",
    "demo:spatial-perception": "tsx scripts/demo-spatial-perception.ts",
    "demo:npc-neighborhood-routine": "tsx scripts/demo-npc-neighborhood-routine.ts",
    "demo:world-opportunity": "tsx scripts/demo-world-opportunity.ts",
    "demo:opportunity-decision": "tsx scripts/demo-opportunity-decision.ts",
    "demo:social-acquaintance": "tsx scripts/demo-social-acquaintance.ts",
    "demo:social-inquiry": "tsx scripts/demo-social-inquiry.ts",
    "demo:spatial-opportunity": "tsx scripts/demo-spatial-opportunity.ts",
