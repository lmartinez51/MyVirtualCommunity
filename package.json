    "demo:all": "node -e \"const fs=require('fs'); const cp=require('child_process'); const pkg=JSON.parse(fs.readFileSync('package.json')); const demos=Object.keys(pkg.scripts).filter(k=>k.startsWith('demo:')&&k!=='demo:all'); for(const d of demos){ console.log('\\n>>> '+d); cp.execSync('npm run '+d, {stdio:'inherit'}); }\""
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
